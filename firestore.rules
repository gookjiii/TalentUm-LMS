rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function signedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeacher() {
      return signedIn() && 
             userExists() && 
             (getUserData().data.get('role', '') in ['teacher', 'leadTeacher', 'admin']);
    }

    function isStudent() {
      return signedIn() && 
             userExists() && 
             getUserData().data.get('role', '') == 'student';
    }

    function isParent() {
      return signedIn() && 
             userExists() && 
             getUserData().data.get('role', '') == 'parent';
    }

    function isAdmin() {
      return signedIn() && userExists() &&
             getUserData().data.get('role', '') in ['admin', 'leadTeacher'];
    }

    function managesClass(classId) {
      return isAdmin() || (
        signedIn() && resource != null &&
        (resource.data.get('teacherId', '') == request.auth.uid ||
         request.auth.uid in resource.data.get('teacherIds', []))
      );
    }

    function canAccessClass(classId) {
      let classDoc = get(/databases/$(database)/documents/classes/$(classId));
      return isAdmin() ||
        request.auth.uid == classDoc.data.get('teacherId', '') ||
        request.auth.uid in classDoc.data.get('teacherIds', []) ||
        request.auth.uid in classDoc.data.get('studentIds', []) ||
        request.auth.uid in classDoc.data.get('parentIds', []);
    }

    function canManageClassById(classId) {
      let classDoc = get(/databases/$(database)/documents/classes/$(classId));
      return isAdmin() ||
        request.auth.uid == classDoc.data.get('teacherId', '') ||
        request.auth.uid in classDoc.data.get('teacherIds', []);
    }

    function canManageAssignment(assignmentId) {
      let assignmentDoc = get(/databases/$(database)/documents/assignments/$(assignmentId));
      return canManageClassById(assignmentDoc.data.get('classId', ''));
    }

    function canAccessAssignment(assignmentId) {
      let assignmentDoc = get(/databases/$(database)/documents/assignments/$(assignmentId));
      return canAccessClass(assignmentDoc.data.get('classId', ''));
    }

    function canAccessRoom(roomId) {
      let roomDoc = get(/databases/$(database)/documents/rooms/$(roomId));
      return isAdmin() ||
        request.auth.uid in roomDoc.data.get('userIds', []) ||
        canAccessClass(roomDoc.data.get('metadata', {}).get('classId', ''));
    }

    function belongsToClass(classId) {
      return signedIn() && 
             userExists() && 
             (classId in getUserData().data.get('classIds', []));
    }

    // --- Collection Rules ---

    // Allow collection group queries for admin stats
    match /{path=**}/messages/{messageId} {
      allow read: if isTeacher();
    }

    match /users/{userId} {
      // Allow any signed-in user to read profiles (needed for resolving names/avatars in chat and class lists)
      allow read: if signedIn();
      // A new identity can be created with their initial profile.
      allow create: if signedIn() && request.auth.uid == userId &&
                    request.resource.data.get('role', '') in ['pending', 'student', 'teacher', 'leadTeacher', 'parent', ''];
      // A teacher may only maintain class membership for student accounts;
      // role/ban/profile changes belong to the account owner or admins.
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'avatarUrl', 'avatar', 'photoURL', 'photoUrl',
           'childIds', 'fcmToken', 'firstName', 'lastActivity',
           'lastName', 'name', 'settings', 'streak',
           'email', 'phone', 'school', 'schoolName', 'bio', 'about',
           'subject', 'subjects', 'updatedAt', 'theme', 'language', 'locale'
         ])) ||
        (request.auth.uid == userId &&
         resource.data.get('role', '') == '' &&
         request.resource.data.get('role', '') == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'role'
         ])) ||
        (request.auth.uid == userId &&
         resource.data.get('role', '') == 'pending' &&
         request.resource.data.get('role', '') == 'student' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'role'
         ])) ||
        (isTeacher() &&
         (request.auth.uid == userId || resource.data.get('role', '') == 'student') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classIds'])) ||
        (exists(/databases/$(database)/documents/parent_link_requests/$(userId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/parent_link_requests/$(userId + '_' + request.auth.uid)).data.get('parentId', '') == userId &&
         get(/databases/$(database)/documents/parent_link_requests/$(userId + '_' + request.auth.uid)).data.get('studentId', '') == request.auth.uid &&
         get(/databases/$(database)/documents/parent_link_requests/$(userId + '_' + request.auth.uid)).data.get('status', '') == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds']) &&
         request.auth.uid in request.resource.data.get('childIds', []))
      );
      allow delete: if isAdmin();

      // FCM push notification tokens — each user manages only their own tokens
      match /tokens/{tokenId} {
        allow read, write, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /classes/{classId} {
      // Query-compatible read rules for students, teachers, and parents
      allow get: if signedIn() && (
        isTeacher() || 
        belongsToClass(classId) || 
        (resource != null && (
          request.auth.uid in resource.data.get('studentIds', []) ||
          request.auth.uid in resource.data.get('parentIds', []) ||
          request.auth.uid == resource.data.get('teacherId', '')
        ))
      );
      
      // Allow query-compatible lists
      allow list: if signedIn() && isTeacher();
      allow list: if signedIn() && request.auth.uid in resource.data.studentIds;
      allow list: if signedIn() && request.auth.uid in resource.data.parentIds;
      allow list: if signedIn() && request.auth.uid == resource.data.teacherId;
      allow create: if isTeacher();
      allow update: if managesClass(classId);
      allow delete: if isTeacher() && (
        resource.data.teacherId == request.auth.uid || 
        getUserData().data.get('role', '') in ['admin', 'leadTeacher']
      );

      match /journal_columns/{columnId} {
        allow read: if signedIn() && (isTeacher() || belongsToClass(classId));
        allow create, update, delete: if isTeacher();
      }

      match /journal_marks/{studentId} {
        allow read: if signedIn() && (
          isTeacher() || 
          isParent() ||
          (belongsToClass(classId) && request.auth.uid == studentId)
        );
        allow create, update, delete: if isTeacher();
      }
    }

    match /rooms/{roomId} {
      // Query-compatible read rules for rooms
      allow read: if signedIn() && (
        isTeacher() || 
        (resource != null && request.auth.uid in resource.data.get('userIds', [])) ||
        (resource != null && belongsToClass(resource.data.metadata.get('classId', '')))
      );
      
      // Teachers can create/update all rooms, students can update rooms they are in (e.g. for membership)
      allow create, update: if signedIn() && (
        isTeacher() || 
        (request.resource != null && (
          request.auth.uid in request.resource.data.get('userIds', []) || 
          belongsToClass(request.resource.data.metadata.get('classId', ''))
        ))
      );
      
      allow delete: if isTeacher();

      match /topics/{topicId} {
        // Anyone who can read the room can read topics
        allow read: if signedIn() && canAccessRoom(roomId);
        
        // ONLY Teachers can create, edit, or delete topics
        allow create, update, delete: if canManageClassById(
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('metadata', {}).get('classId', '')
        );
      }

      match /messages/{messageId} {
        // Anyone who can read the room can read messages
        allow read: if signedIn() && canAccessRoom(roomId);
        
        allow create: if signedIn() && canAccessRoom(roomId)
          && request.resource.data.authorId == request.auth.uid;
        
        allow update: if signedIn() && (
          request.auth.uid == resource.data.authorId || 
          canManageClassById(get(/databases/$(database)/documents/rooms/$(roomId)).data.get('metadata', {}).get('classId', '')) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metadata']) &&
           (!('metadata' in resource.data) || request.resource.data.metadata.diff(resource.data.metadata).affectedKeys().hasOnly(['seenBy'])))
        );
          
        allow delete: if canManageClassById(
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('metadata', {}).get('classId', '')
        );
      }

      match /polls/{pollId} {
        allow read: if signedIn() && canAccessRoom(roomId);
        allow create, delete: if canManageClassById(
          get(/databases/$(database)/documents/rooms/$(roomId)).data.get('metadata', {}).get('classId', '')
        );
        allow update: if signedIn() && canAccessRoom(roomId); // students vote via update
      }

      match /typing/{userId} {
        allow read: if signedIn() && canAccessRoom(roomId);
        allow write, delete: if signedIn() && request.auth.uid == userId && canAccessRoom(roomId);
      }
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && canAccessClass(resource.data.classId);
      allow create: if canManageClassById(request.resource.data.classId);
      allow update: if canManageClassById(request.resource.data.classId);
      allow delete: if canManageClassById(resource.data.classId);
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid || 
        (isTeacher() && canAccessAssignment(resource.data.get('assignmentId', ''))) ||
        (isParent() && resource.data.studentId in getUserData().data.get('childIds', []))
      );
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.studentId == request.auth.uid || 
        (isTeacher() && canManageAssignment(resource.data.get('assignmentId', '')))
      );
      allow delete: if isTeacher() && canManageAssignment(resource.data.get('assignmentId', ''));
    }

    match /grades/{gradeId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid || 
        (isTeacher() && canAccessClass(resource.data.get('classId', ''))) ||
        (isParent() && resource.data.studentId in getUserData().data.get('childIds', []))
      );
      allow create: if isTeacher() && canAccessClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && canAccessClass(resource.data.classId);
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isTeacher();
      allow delete: if false;
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn() && canAccessClass(resource.data.classId);
      allow create: if canManageClassById(request.resource.data.classId);
      allow update: if canManageClassById(request.resource.data.classId);
      allow delete: if canManageClassById(resource.data.classId);
    }

    match /schedule_overrides/{overrideId} {
      allow read: if signedIn() && canAccessClass(resource.data.classId);
      allow create: if canManageClassById(request.resource.data.classId);
      allow update: if canManageClassById(request.resource.data.classId);
      allow delete: if canManageClassById(resource.data.classId);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isTeacher();
      allow update: if isTeacher() || (
        signedIn() && (
          (resource != null && resource.data.get('authorId', '') == request.auth.uid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes'])
        )
      );
      allow delete: if isTeacher() || (
        signedIn() && resource != null && resource.data.get('authorId', '') == request.auth.uid
      );
    }

    match /library_materials/{materialId} {
      allow read: if signedIn() && canAccessClass(resource.data.classId);
      allow create: if canManageClassById(request.resource.data.classId);
      allow update: if canManageClassById(request.resource.data.classId);
      allow delete: if canManageClassById(resource.data.classId);
    }

    match /webinars/{webinarId} {
      allow read: if signedIn() && canAccessClass(resource.data.classId);
      allow create: if canManageClassById(request.resource.data.classId);
      allow update: if canManageClassById(request.resource.data.classId);
      allow delete: if canManageClassById(resource.data.classId);
    }

    match /teacher_requests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == requestId || getUserData().data.get('role', '') in ['admin', 'leadTeacher']);
      allow create: if signedIn() && request.auth.uid == requestId;
      allow update, delete: if signedIn() && (request.auth.uid == requestId || getUserData().data.get('role', '') in ['admin', 'leadTeacher']);
    }

    match /parent_link_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.get('parentId', '') == request.auth.uid &&
        requestId == request.auth.uid + '_' + request.resource.data.get('studentId', '') &&
        request.resource.data.get('status', '') == 'pending' &&
        get(/databases/$(database)/documents/users/$(request.resource.data.get('studentId', ''))).data.get('role', '') == 'student';
      allow read: if signedIn() && (
        resource.data.get('parentId', '') == request.auth.uid ||
        resource.data.get('studentId', '') == request.auth.uid
      );
      allow update: if signedIn() &&
        resource.data.get('studentId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
        request.resource.data.get('status', '') in ['approved', 'rejected'];
      allow delete: if signedIn() && (
        resource.data.get('parentId', '') == request.auth.uid ||
        resource.data.get('studentId', '') == request.auth.uid
      );
    }
  }
}

{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/admin/storage_stats", "dest": "/api/admin/storage_stats.ts" },
    { "src": "/api/admin/storage_cleanup", "dest": "/api/admin/storage_cleanup.ts" },
    { "src": "/api/library/image", "dest": "/api/library/image.ts" },
    { "src": "/api/library/proxy_pdf", "dest": "/api/library/proxy_pdf.ts" },
    { "src": "/api/upload/initiate", "dest": "/api/upload/initiate.ts" },
    { "src": "/api/upload/complete", "dest": "/api/upload/complete.ts" },
    { "src": "/api/upload/delete_drive", "dest": "/api/upload/delete_drive.ts" },
    { "src": "/api/upload/delete_cloudinary", "dest": "/api/upload/delete_cloudinary.ts" },
    { "src": "/api/notifications/send", "dest": "/api/notifications/send.ts" },
    { "src": "/api/auth/delete_user", "dest": "/api/auth/delete_user.ts" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, X-Upload-Url, Content-Range, X-Upload-Content-Type, X-Upload-Content-Length" },
        { "key": "Access-Control-Expose-Headers", "value": "Range, Content-Range" }
      ]
    }
  ]
}
